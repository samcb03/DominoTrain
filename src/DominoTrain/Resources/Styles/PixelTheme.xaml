<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:DominoTrain.Resources">
    <!-- Reference palette. Ink is the dark neutral used for readable text and outlines. -->
    <SolidColorBrush x:Key="Glacier" Color="#D5FAF9" />
    <SolidColorBrush x:Key="Mist" Color="#C1F0E2" />
    <SolidColorBrush x:Key="Frost" Color="#7FE3D7" />
    <SolidColorBrush x:Key="Mint" Color="#96D2C2" />
    <SolidColorBrush x:Key="Seafoam" Color="#6DD0B7" />
    <SolidColorBrush x:Key="Aqua" Color="#4FC7A7" />
    <SolidColorBrush x:Key="Ink" Color="#173D35" />
    <FontFamily x:Key="PixelFont">pack://application:,,,/DominoTrain;component/Assets/Fonts/#Press Start 2P</FontFamily>
    <DrawingBrush x:Key="GridPattern" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Mist}" Geometry="M0,0 H32 V32 H0 Z" />
                <GeometryDrawing Brush="{StaticResource Mint}" Geometry="M0,0 H32 V1 H1 V32 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="VolumeSegments" TileMode="Tile" Viewport="0,0,16,8" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Mist}" Geometry="M0,0 H16 V8 H0 Z" />
                <GeometryDrawing Brush="{StaticResource Aqua}" Geometry="M0,0 H12 V8 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="PixelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource PixelText}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="8" Background="{TemplateBinding Background}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PixelSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="{x:Static resources:SettingsDefaults.MinimumVolume}" />
        <Setter Property="Maximum" Value="{x:Static resources:SettingsDefaults.MaximumVolume}" />
        <Setter Property="SmallChange" Value="{x:Static resources:SettingsDefaults.VolumeStep}" />
        <Setter Property="LargeChange" Value="{x:Static resources:SettingsDefaults.VolumePageStep}" />
        <Setter Property="TickFrequency" Value="{x:Static resources:SettingsDefaults.VolumeStep}" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid SnapsToDevicePixels="True">
                        <Border
                            x:Name="VolumeRail"
                            Height="20"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="2"
                            Background="{StaticResource Mint}" />
                        <Border Height="8" Margin="8,0" Background="{StaticResource Mist}" />
                        <!-- WPF requires the PART_Track template name for Slider behavior. -->
                        <Track
                            x:Name="PART_Track"
                            Margin="6,0"
                            Minimum="{TemplateBinding Minimum}"
                            Maximum="{TemplateBinding Maximum}"
                            Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Style="{StaticResource TrackButton}"
                                    Background="{StaticResource VolumeSegments}"
                                    Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="26" Height="34">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Border Margin="3,3,0,0" Background="{StaticResource Ink}" />
                                                <Border
                                                    x:Name="SliderHandle"
                                                    Margin="0,0,3,3"
                                                    Background="{StaticResource Glacier}"
                                                    BorderBrush="{StaticResource Ink}"
                                                    BorderThickness="3">
                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                        <Rectangle
                                                            Width="2"
                                                            Height="11"
                                                            Fill="{StaticResource Ink}"
                                                            Margin="0,0,3,0" />
                                                        <Rectangle Width="2" Height="11" Fill="{StaticResource Ink}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter
                                                        TargetName="SliderHandle"
                                                        Property="Background"
                                                        Value="{StaticResource Frost}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Style="{StaticResource TrackButton}"
                                    Background="Transparent"
                                    Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="VolumeRail" Property="BorderThickness" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PixelButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Mist}" />
        <Setter Property="Padding" Value="22,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{StaticResource Ink}" Margin="4,4,0,0" />
                        <Border
                            x:Name="ButtonSurface"
                            Margin="0,0,4,4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                            <TextBlock
                                Text="{TemplateBinding Content}"
                                Style="{StaticResource PixelText}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource Frost}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="4" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonSurface" Property="Margin" Value="3,3,1,1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LanguageOption" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="LanguageCard"
                        BorderBrush="{StaticResource Ink}"
                        BorderThickness="2"
                        Background="{StaticResource Mist}"
                        Padding="16,14"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                BorderBrush="{StaticResource Ink}"
                                BorderThickness="2"
                                Background="{StaticResource Glacier}">
                                <Path
                                    x:Name="SelectionMark"
                                    Visibility="Collapsed"
                                    Fill="{StaticResource Ink}"
                                    Data="M2,6 H5 V9 H8 V3 H11 V11 H5 V9 H2 Z" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LanguageCard" Property="Background" Value="{StaticResource Frost}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="LanguageCard" Property="Background" Value="{StaticResource Aqua}" />
                            <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="LanguageCard" Property="BorderThickness" Value="3" />
                            <Setter TargetName="LanguageCard" Property="Padding" Value="15,13" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
