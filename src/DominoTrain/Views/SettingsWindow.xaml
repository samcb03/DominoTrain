<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrain.ViewModels"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    x:Class="DominoTrain.Views.SettingsWindow"
    Title="{Binding [SettingsWindowTitle]}"
    Width="1220"
    Height="880"
    MinWidth="960"
    MinHeight="700"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource Mist}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    xmlns:strings="clr-namespace:DominoTrain.Resources.Localization"
    xmlns:resources="clr-namespace:DominoTrain.Resources"
    ShowInTaskbar="False">
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.42" IsHitTestVisible="False" />
        <Viewbox Stretch="Uniform">
            <Grid Width="1200" Height="820" Margin="0" TextOptions.TextFormattingMode="Display">
                <Grid Margin="48,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid VerticalAlignment="Top" Margin="0,6,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="46" Margin="0,0,16,0">
                                <Border Background="{StaticResource Ink}" Margin="4,4,0,0" />
                                <Border
                                    Background="{StaticResource Glacier}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="3"
                                    Margin="0,0,4,4">
                                    <Canvas>
                                        <Path
                                            Fill="{StaticResource Ink}"
                                            Data="M5,5 H11 V11 H5 Z M19,5 H25 V11 H19 Z M0,16 H30 V19 H0 Z M12,25
                                                H18 V31 H12 Z" />
                                    </Canvas>
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding [GameTitle]}"
                                    Style="{StaticResource PixelText}"
                                    FontSize="16" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border
                                Background="{StaticResource Frost}"
                                BorderBrush="{StaticResource Ink}"
                                BorderThickness="2"
                                Padding="12,9">
                                <TextBlock
                                    Text="{Binding [SettingsTitle]}"
                                    Style="{StaticResource PixelText}"
                                    FontSize="9" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border
                            Margin="0,0,8,8"
                            Background="{StaticResource Glacier}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="268" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{StaticResource Aqua}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="0,0,4,0">
                                    <Grid ClipToBounds="True">
                                        <Canvas
                                            Width="264"
                                            Height="256"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,92"
                                            IsHitTestVisible="False"
                                            RenderOptions.EdgeMode="Aliased">
                                            <Path
                                                Fill="{StaticResource Mist}"
                                                Data="M24,46 H36 V34 H60 V40 H72 V52 H84 V58 H24 Z M166,18 H178 V6
                                                    H196 V12 H208 V24 H220 V30 H166 Z" />
                                            <Path
                                                Fill="{StaticResource Seafoam}"
                                                Data="M0,150 H24 V132 H48 V114 H72 V126 H96 V150 H120 V138 H144
                                                    V114 H168 V90 H192 V114 H216 V138 H240 V150 H264 V232 H0 Z" />
                                            <Path
                                                Fill="{StaticResource Mint}"
                                                Data="M0,202 H24 V190 H48 V178 H72 V190 H96 V202 H132 V178 H156
                                                    V166 H180 V178 H204 V190 H228 V178 H264 V232 H0 Z" />
                                            <Path
                                                Fill="{StaticResource Glacier}"
                                                Data="M148,90 H166 V102 H148 Z M170,66 H194 V78 H170 Z M198,48 H216
                                                    V60 H198 Z" />
                                            <Canvas Canvas.Left="16" Canvas.Top="110" Width="116" Height="56">
                                                <Canvas.RenderTransform>
                                                    <ScaleTransform ScaleX="2" ScaleY="2" />
                                                </Canvas.RenderTransform>
                                                <Path
                                                    Fill="{StaticResource Ink}"
                                                    Data="M0,20 H34 V46 H0 Z M32,38 H42 V42 H32 Z" />
                                                <Path Fill="{StaticResource Glacier}" Data="M3,23 H31 V41 H3 Z" />
                                                <Path
                                                    Fill="{StaticResource Ink}"
                                                    Data="M15,23 H18 V41 H15 Z M6,26 H10 V30 H6 Z M23,34 H27 V38
                                                        H23 Z M23,26 H27 V30 H23 Z M6,34 H10 V38 H6 Z" />
                                                <Path
                                                    Fill="{StaticResource Ink}"
                                                    Data="M38,9 H70 V14 H67 V27 H79 V15 H76 V11 H91 V15 H88 V27 H98
                                                        V31 H104 V37 H109 V43 H113 V47 H38 Z" />
                                                <Path Fill="{StaticResource Frost}" Data="M43,14 H62 V31 H43 Z" />
                                                <Path Fill="{StaticResource Ink}" Data="M47,17 H58 V27 H47 Z" />
                                                <Path
                                                    Fill="{StaticResource Aqua}"
                                                    Data="M43,34 H99 V40 H105 V43 H43 Z" />
                                                <Path
                                                    Fill="{StaticResource Glacier}"
                                                    Data="M72,30 H94 V33 H72 Z M44,35 H50 V38 H44 Z" />
                                                <Path
                                                    Fill="{StaticResource Ink}"
                                                    Data="M5,44 H17 V53 H5 Z M22,44 H32 V53 H22 Z M46,43 H61 V56
                                                        H46 Z M77,43 H92 V56 H77 Z" />
                                                <Path
                                                    Fill="{StaticResource Mint}"
                                                    Data="M9,47 H13 V50 H9 Z M25,47 H29 V50 H25 Z M50,47 H57 V52
                                                        H50 Z M81,47 H88 V52 H81 Z" />
                                                <Path Fill="{StaticResource Glacier}" Data="M54,47 H85 V49 H54 Z" />
                                            </Canvas>
                                            <Path
                                                Fill="{StaticResource Ink}"
                                                Data="M0,228 H264 V232 H0 Z M0,242 H264 V246 H0 Z M12,228 H20 V252
                                                    H12 Z M44,228 H52 V252 H44 Z M76,228 H84 V252 H76 Z M108,228
                                                    H116 V252 H108 Z M140,228 H148 V252 H140 Z M172,228 H180 V252
                                                    H172 Z M204,228 H212 V252 H204 Z M236,228 H244 V252 H236 Z" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1" Margin="36,28,36,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="74" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="116" />
                                        <RowDefinition Height="116" />
                                        <RowDefinition Height="54" />
                                        <RowDefinition Height="76" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding [SettingsTitle]}"
                                            Style="{StaticResource PixelText}"
                                            FontSize="24"
                                            Margin="0,2,0,0" />
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock
                                            Text="{Binding [AudioSectionLabel]}"
                                            Style="{StaticResource SectionLabel}"
                                            DockPanel.Dock="Left"
                                            Margin="0,0,18,0" />
                                        <Border
                                            Background="{StaticResource Mint}"
                                            Height="2"
                                            VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Grid Grid.Row="2" Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="44"
                                            Height="44"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Ink}"
                                            BorderThickness="2"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Left">
                                            <Path
                                                Fill="{StaticResource Ink}"
                                                Margin="8"
                                                Stretch="Uniform"
                                                Data="M8,0 H24 V5 H12 V21 H8 V25 H0 V17 H8 Z M20,5 H24 V17 H20 V21
                                                    H12 V13 H20 Z" />
                                        </Border>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24" />
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="18" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Text="{Binding [MusicVolumeLabel]}"
                                                Style="{StaticResource PixelText}"
                                                VerticalAlignment="Center" />
                                            <Border
                                                HorizontalAlignment="Right"
                                                Background="{StaticResource Mist}"
                                                Padding="9,5"
                                                Margin="0,-4,0,0">
                                                <TextBlock Style="{StaticResource PixelText}" FontSize="10">
                                                    <TextBlock.Text>
                                                        <Binding
                                                            Path="Value"
                                                            ElementName="_musicVolumeSlider"
                                                            StringFormat="{x:Static
                                                                strings:UiStrings.VolumePercentageFormat}" />
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                            <Slider
                                                x:Name="_musicVolumeSlider"
                                                Value="{x:Static resources:SettingsDefaults.DefaultMusicVolume}"
                                                Style="{StaticResource PixelSlider}"
                                                AutomationProperties.Name="{Binding [MusicVolumeAccessibleName]}"
                                                Margin="0,24,0,22"
                                                Grid.RowSpan="3"
                                                x:FieldModifier="private" />
                                        </Grid>
                                    </Grid>
                                    <Grid Grid.Row="3" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="44"
                                            Height="44"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Ink}"
                                            BorderThickness="2"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Left">
                                            <Path
                                                Fill="{StaticResource Ink}"
                                                Margin="8"
                                                Stretch="Uniform"
                                                Data="M0,8 H5 V4 H9 V0 H13 V24 H9 V20 H5 V16 H0 Z M17,6 H20 V18 H17
                                                    Z M22,2 H25 V22 H22 Z" />
                                        </Border>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24" />
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="18" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Text="{Binding [SoundEffectsVolumeLabel]}"
                                                Style="{StaticResource PixelText}"
                                                VerticalAlignment="Center" />
                                            <Border
                                                HorizontalAlignment="Right"
                                                Background="{StaticResource Mist}"
                                                Padding="9,5"
                                                Margin="0,-4,0,0">
                                                <TextBlock Style="{StaticResource PixelText}" FontSize="10">
                                                    <TextBlock.Text>
                                                        <Binding
                                                            Path="Value"
                                                            ElementName="_soundEffectsVolumeSlider"
                                                            StringFormat="{x:Static
                                                                strings:UiStrings.VolumePercentageFormat}" />
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                            <Slider
                                                x:Name="_soundEffectsVolumeSlider"
                                                Grid.Row="1"
                                                Value="{x:Static resources:SettingsDefaults.DefaultSoundEffectsVolume}"
                                                Style="{StaticResource PixelSlider}"
                                                AutomationProperties.Name="{Binding [SoundEffectsVolumeAccessibleName]}"
                                                Margin="0,3,0,18"
                                                Grid.RowSpan="2"
                                                x:FieldModifier="private" />
                                        </Grid>
                                    </Grid>
                                    <DockPanel Grid.Row="4" Margin="0,12,0,0">
                                        <TextBlock
                                            Text="{Binding [LanguageSectionLabel]}"
                                            Style="{StaticResource SectionLabel}"
                                            DockPanel.Dock="Left"
                                            Margin="0,0,18,0" />
                                        <Border
                                            Background="{StaticResource Mint}"
                                            Height="2"
                                            VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Grid Grid.Row="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="_spanishLanguageOption"
                                            GroupName="Language"
                                            IsChecked="{Binding IsSpanishSelected, Mode=TwoWay}"
                                            Style="{StaticResource LanguageOption}"
                                            AutomationProperties.Name="{Binding [SpanishLanguageAccessibleName]}"
                                            x:FieldModifier="private">
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="40"
                                                    Height="40"
                                                    Background="{StaticResource Glacier}"
                                                    BorderBrush="{StaticResource Ink}"
                                                    BorderThickness="2"
                                                    Margin="0,0,14,0">
                                                    <TextBlock
                                                        Text="{Binding [SpanishLanguageCode]}"
                                                        Style="{StaticResource PixelText}"
                                                        FontSize="10"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding [SpanishLanguageName]}"
                                                        Style="{StaticResource PixelText}"
                                                        FontSize="11" />
                                                    <TextBlock
                                                        Text="{Binding [SpanishLanguageDescription]}"
                                                        FontSize="13"
                                                        Margin="0,7,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="_englishLanguageOption"
                                            Grid.Column="2"
                                            GroupName="Language"
                                            IsChecked="{Binding IsEnglishSelected, Mode=TwoWay}"
                                            Style="{StaticResource LanguageOption}"
                                            AutomationProperties.Name="{Binding [EnglishLanguageAccessibleName]}"
                                            x:FieldModifier="private">
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="40"
                                                    Height="40"
                                                    Background="{StaticResource Glacier}"
                                                    BorderBrush="{StaticResource Ink}"
                                                    BorderThickness="2"
                                                    Margin="0,0,14,0">
                                                    <TextBlock
                                                        Text="{Binding [EnglishLanguageCode]}"
                                                        Style="{StaticResource PixelText}"
                                                        FontSize="10"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding [EnglishLanguageName]}"
                                                        Style="{StaticResource PixelText}"
                                                        FontSize="11" />
                                                    <TextBlock
                                                        Text="{Binding [EnglishLanguageDescription]}"
                                                        FontSize="13"
                                                        Margin="0,7,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>
                                    <Grid Grid.Row="6" Margin="0,26,0,0">
                                        <Grid VerticalAlignment="Bottom">
                                            <Button
                                                Content="{Binding [BackButtonLabel]}"
                                                Style="{StaticResource PixelButton}"
                                                HorizontalAlignment="Left"
                                                Width="154"
                                                Height="50"
                                                AutomationProperties.Name="{Binding [BackButtonAccessibleName]}" />
                                            <Button
                                                Content="{Binding [SaveButtonLabel]}"
                                                Style="{StaticResource PixelButton}"
                                                HorizontalAlignment="Right"
                                                Width="188"
                                                Height="50"
                                                Background="{StaticResource Ink}"
                                                Foreground="{StaticResource Glacier}"
                                                AutomationProperties.Name="{Binding [SaveButtonAccessibleName]}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
