<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <NeutralLanguage>es</NeutralLanguage>
    </PropertyGroup>
    <ItemGroup>
      <None Remove="Resources\Images\PixelTrain.png" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Assets/Fonts/PressStart2P-Regular.ttf" />
        <Resource Include="Resources\Images\PixelTrain.png" />
        <None Update="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- WPF needs the generated resource class before compiling local XAML type references. -->
    <Target Name="GenerateUiStrings" BeforeTargets="MarkupCompilePass1">
        <GenerateResource Sources="Resources/Localization/UiStrings.resx" ExecuteAsTool="false" UsePreserializedResources="true" OutputResources="$(IntermediateOutputPath)UiStrings.generated.resources" StronglyTypedLanguage="C#" StronglyTypedClassName="UiStrings" StronglyTypedNamespace="DominoTrain.Resources.Localization" StronglyTypedFileName="$(IntermediateOutputPath)UiStrings.g.cs" PublicClass="true">
            <Output TaskParameter="StronglyTypedFileName" ItemName="Compile" />
            <Output TaskParameter="StronglyTypedFileName" ItemName="_GeneratedCodeFiles" />
            <Output TaskParameter="FilesWritten" ItemName="FileWrites" />
        </GenerateResource>
    </Target>
</Project>
