root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
csharp_style_expression_bodied_methods = false:suggestion

dotnet_naming_rule.types_use_pascal_case.symbols = types
dotnet_naming_rule.types_use_pascal_case.style = pascal_case
dotnet_naming_rule.types_use_pascal_case.severity = warning
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate

dotnet_naming_rule.members_use_pascal_case.symbols = members
dotnet_naming_rule.members_use_pascal_case.style = pascal_case
dotnet_naming_rule.members_use_pascal_case.severity = warning
dotnet_naming_symbols.members.applicable_kinds = method, property, event

dotnet_naming_rule.constants_use_pascal_case.symbols = constants
dotnet_naming_rule.constants_use_pascal_case.style = pascal_case
dotnet_naming_rule.constants_use_pascal_case.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.fields_use_underscore_camel_case.symbols = private_or_internal_fields
dotnet_naming_rule.fields_use_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.fields_use_underscore_camel_case.severity = warning
dotnet_naming_symbols.private_or_internal_fields.applicable_kinds = field
dotnet_naming_symbols.private_or_internal_fields.applicable_accessibilities = private, internal

dotnet_naming_rule.variables_use_camel_case.symbols = variables
dotnet_naming_rule.variables_use_camel_case.style = camel_case
dotnet_naming_rule.variables_use_camel_case.severity = warning
dotnet_naming_symbols.variables.applicable_kinds = local, parameter

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

[*.g.cs]
generated_code = true
